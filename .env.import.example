# scripts/ 下的导入脚本用的后台凭据。
# 复制成 .env.import 再填 —— .env.import 已在 .gitignore 里，不会进仓库。
#
#   cp .env.import.example .env.import
#
# 临时换目标站点不用改文件，命令前加一次变量就行（命令行优先于文件）：
#   PAYLOAD_URL=http://localhost:3000 node scripts/import-case-study.mjs <json> --dry-run

# 目标站点，末尾不要带斜杠
PAYLOAD_URL=https://efmc-automation.com

# 后台账号密码（有写权限的用户）
PAYLOAD_EMAIL=
PAYLOAD_PASSWORD=
