# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env
# 导入脚本的后台凭据（.env.import.example 是模板，那个要进仓库）
.env.import

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
uploads/
seed/.assets/

# playwright
/test-results/
/playwright-report/

# 二维码原图与裁切产物：走 CMS 上传（站点设置 → 微信/WhatsApp 二维码），不进仓库
wechat.jpg
whatsapp.jpg
qr-*.png

# 厂房/车间照片的裁切中转目录：走 CMS 上传（Pages → about → 图片画廊），不进仓库
photos-out/

# 产品选图的联系表导出（prep-product-images.mjs sheet → build 的中间产物）
selection.json

# JetBrains IDE 的本地配置（.vscode/ 是共享的，故意提交，别加进来）
.idea/

# Claude Code 的本机配置：命令放行规则带本机绝对路径，因人因机而异，不共享
# （.claude/settings.json、hooks/、agents/、skills/ 是仓库级自动化，故意提交）
.claude/settings.local.json

# 客户端预览的生成物（case-preview.mjs 在 case.json 旁边生成）
preview-en.html
preview-zh.html

# 外部装的 skill（npx skills add payloadcms/skills）：
# .agents/ 是拉下来的第三方内容，.claude/skills/ 下的同名项是指向它的**绝对路径符号链接**
# （/e/wrk/EFMC/... 写死了本机盘符），提交进去换台机器就是断链，还跟自家那几个 skill 混在一起。
# 提交 skills-lock.json 就够了 —— 里面有来源和内容哈希，换机器重新装一次即可：
#   npx skills add payloadcms/skills
.agents/
.claude/skills/payload
.claude/skills/cms-migration
